# GoHighLevel inbound webhook URL (Workflow → Trigger → Inbound Webhook).
# Leave unset to log inquiries to the server console instead.
GHL_WEBHOOK_URL=

# LeadConnector chat widget id (GHL → Sites → Chat Widget).
# Leave unset and no chat widget renders.
NEXT_PUBLIC_GHL_CHAT_WIDGET_ID=

# ── Admin CMS / AWS backend (server-side only — never NEXT_PUBLIC_*) ──
# Session signing secret, >=32 chars. Required in production. openssl rand -hex 32
SESSION_SECRET=
# Set these to switch the store from .data/catalog.json to DynamoDB + S3
# (provision first: node scripts/aws/provision.mjs — see scripts/aws/AWS-SETUP.md)
AWS_REGION=
DYNAMO_TABLE=
S3_BUCKET=
S3_PUBLIC_BASE=

# ── Dealer onboarding & Aadhaar e-Sign (Module 10) ──
# Orkay's own Digio account; per-signature charges are theirs, at actuals.
# Leave unset in dev: the e-Sign step runs in stub mode so the apply → verify →
# sign → dealer-code flow is testable. The stub is refused in production.
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
# The dealer-agreement template Orkay has approved inside their Digio account.
DIGIO_TEMPLATE_ID=
# Shared secret for the signature on Digio's webhook. Required in production —
# without it, anyone who finds /api/digio/webhook can appoint themselves a dealer.
DIGIO_WEBHOOK_SECRET=
# Sandbox: https://ext.digio.in:444
DIGIO_BASE_URL=

# GSTIN lookup for the dealership form. Uses DIGIO_CLIENT_ID / _SECRET above —
# nothing extra to arrange. Unset, the form falls back to the check-digit test
# and the application is stored as "GST NOT VERIFIED" for the desk to check.
# Only override the path if Digio's current docs disagree with it.
DIGIO_GST_PATH=
